  >

  <style>
    :root {
      --navy: #0f172a;
      --navy-2: #111c33;
      --teal: #14b8a6;
      --teal-light: #5eead4;
      --white: #ffffff;
      --text: #e2e8f0;
      --muted: #94a3b8;
      --border: rgba(255,255,255,0.12);
      --card: rgba(255,255,255,0.055);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Inter, Arial, Helvetica, sans-serif;
      background: var(--navy);
      color: var(--white);
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1120px, 92%);
      margin: auto;
    }

    /* NAVIGATION */

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(15,23,42,0.96);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }

    nav {
      min-height: 72px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 25px;
      font-weight: 800;
    }

    .logo span {
      color: var(--teal);
    }

    .nav-links {
      display: flex;
      gap: 22px;
      list-style: none;
    }

    .nav-links a {
      color: #cbd5e1;
      font-size: 14px;
      transition: 0.3s;
    }

    .nav-links a:hover {
      color: var(--teal-light);
    }

    /* HERO */

    .hero {
      min-height: 90vh;
      display: flex;
      align-items: center;
      overflow: hidden;
      position: relative;
      padding: 80px 0;
    }

    .hero::before {
      content: "";
      position: absolute;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      background: rgba(20,184,166,0.08);
      right: -160px;
      top: 60px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 50px;
      align-items: center;
      position: relative;
    }

    .badge {
      display: inline-block;
      padding: 8px 15px;
      border-radius: 50px;
      color: var(--teal-light);
      background: rgba(20,184,166,0.08);
      border: 1px solid rgba(20,184,166,0.35);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.5px;
      margin-bottom: 22px;
    }

    .hero h1 {
      font-size: clamp(45px, 7vw, 76px);
      line-height: 0.98;
      letter-spacing: -3px;
      margin-bottom: 20px;
    }

    .hero h1 span {
      color: var(--teal);
    }

    .hero h2 {
      color: #cbd5e1;
      font-size: clamp(18px, 3vw, 27px);
      font-weight: 500;
      margin-bottom: 18px;
    }

    .hero-description {
      color: var(--muted);
      font-size: 16px;
      max-width: 680px;
      margin-bottom: 28px;
    }

    .buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 13px 20px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 700;
      transition: 0.3s;
    }

    .btn-primary {
      background: var(--teal);
      color: var(--navy);
    }

    .btn-primary:hover {
      background: var(--teal-light);
      transform: translateY(-2px);
    }

    .btn-outline {
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      color: white;
    }

    .btn-outline:hover {
      border-color: var(--teal);
      color: var(--teal-light);
    }

    /* DIGITAL MARKETING DIAGRAM */

    .diagram {
      position: relative;
      min-height: 470px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .diagram::before {
      content: "";
      position: absolute;
      width: 320px;
      height: 320px;
      border: 1px solid rgba(20,184,166,0.15);
      border-radius: 50%;
    }

    .diagram::after {
      content: "";
      position: absolute;
      width: 240px;
      height: 240px;
      border: 1px dashed rgba(94,234,212,0.16);
      border-radius: 50%;
    }

    .center-node {
      width: 150px;
      height: 150px;
      border-radius: 50%;
      background: var(--teal);
      color: var(--navy);
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-weight: 900;
      font-size: 17px;
      line-height: 1.2;
      box-shadow: 0 0 0 12px rgba(20,184,166,0.07);
      z-index: 3;
    }

    .node {
      position: absolute;
      width: 112px;
      min-height: 72px;
      padding: 13px 8px;
      border: 1px solid var(--border);
      border-radius: 15px;
      background: var(--card);
      backdrop-filter: blur(8px);
      color: #e2e8f0;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: 12px;
      font-weight: 700;
      z-index: 4;
    }

    .node-1 {
      top: 10px;
      left: 50%;
      transform: translateX(-50%);
    }

    .node-2 {
      top: 105px;
      right: 5px;
    }

    .node-3 {
      bottom: 105px;
      right: 5px;
    }

    .node-4 {
      bottom: 10px;
      left: 50%;
      transform: translateX(-50%);
    }

    .node-5 {
      bottom: 105px;
      left: 5px;
    }

    .node-6 {
      top: 105px;
      left: 5px;
    }

    /* SECTIONS */

    section {
      padding: 90px 0;
    }

    .section-heading {
      margin-bottom: 40px;
    }

    .section-heading small {
      color: var(--teal);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-weight: 800;
    }

    .section-heading h2 {
      font-size: clamp(30px,5vw,46px);
      line-height: 1.1;
      margin-top: 8px;
    }

    .section-heading p {
      color: var(--muted);
      max-width: 700px;
      margin-top: 12px;
    }

    /* ABOUT */

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .about-card {
      padding: 30px;
      border-radius: 20px;
      background: var(--card);
      border: 1px solid var(--border);
    }

    .about-card p {
      color: #cbd5e1;
      margin-bottom: 14px;
    }

    .highlight {
      color: var(--teal-light);
      font-weight: 700;
    }

    /* EXPERIENCE */

    .experience-card {
      display: grid;
      grid-template-columns: 190px 1fr;
      gap: 30px;
      padding: 32px;
      border-radius: 20px;
      background: var(--card);
      border: 1px solid var(--border);
    }

    .experience-number {
      color: var(--teal);
      font-size: 52px;
      line-height: 1;
      font-weight: 900;
    }

    .experience-card h3 {
      font-size: 24px;
      margin-bottom: 8px;
    }

    .experience-card p {
      color: var(--muted);
    }

    /* SKILLS */

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 18px;
    }

    .skill-card {
      padding: 25px;
      border-radius: 17px;
      background: var(--card);
      border: 1px solid var(--border);
      transition: 0.3s;
    }

    .skill-card:hover {
      transform: translateY(-5px);
      border-color: rgba(20,184,166,0.5);
    }

    .skill-card h3 {
      color: var(--teal-light);
      font-size: 18px;
      margin-bottom: 9px;
    }

    .skill-card p {
      color: var(--muted);
      font-size: 14px;
    }

    /* PROJECTS */

    .projects {
      display: grid;
      grid-template-columns: repeat(2,1fr);
      gap: 24px;
    }

    .project-card {
      padding: 30px;
      border-radius: 20px;
      background: var(--card);
      border: 1px solid var(--border);
    }

    .project-card.featured {
      border-color: rgba(20,184,166,0.5);
    }

    .project-label {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 30px;
      background: rgba(20,184,166,0.1);
      color: var(--teal-light);
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 15px;
    }

    .project-card h3 {
      font-size: 28px;
      margin-bottom: 5px;
    }

    .project-card h4 {
      color: #cbd5e1;
      font-weight: 500;
      margin-bottom: 15px;
    }

    .project-card > p {
      color: var(--muted);
      margin-bottom: 18px;
    }

    .project-list {
      list-style: none;
      margin-bottom: 22px;
    }

    .project-list li {
      color: #cbd5e1;
      font-size: 14px;
      margin: 7px 0;
    }

    .project-list li::before {
      content: "✓";
      color: var(--teal);
      font-weight: bold;
      margin-right: 9px;
    }

    /* CASE STUDY */

    .case-study {
      background: var(--navy-2);
    }

    .case-grid {
      display: grid;
      grid-template-columns: repeat(4,1fr);
      gap: 15px;
    }

    .case-box {
      padding: 24px;
      border-radius: 16px;
      border: 1px solid var(--border);
      background: rgba(255,255,255,0.03);
    }

    .case-box span {
      display: block;
      color: var(--teal);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1px;
      margin-bottom: 9px;
    }

    .case-box p {
      color: #cbd5e1;
      font-size: 14px;
    }

    /* SERVICES */

    .services-grid {
      display: grid;
      grid-template-columns: repeat(4,1fr);
      gap: 15px;
    }

    .service {
      padding: 23px;
      border-radius: 15px;
      background: var(--card);
      border: 1px solid var(--border);
    }

    .service h3 {
      font-size: 16px;
      margin-bottom: 7px;
    }

    .service p {
      color: var(--muted);
      font-size: 13px;
    }

    /* TOOLS */

    .tools {
      display: flex;
      flex-wrap: wrap;
      gap: 11px;
    }

    .tool {
      padding: 11px 16px;
      border-radius: 9px;
      background: var(--card);
      border: 1px solid var(--border);
      color: #dbeafe;
      font-size: 14px;
    }

    /* CERTIFICATES */

    .cert-grid {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 18px;
    }

    .cert-card {
      padding: 25px;
      border-radius: 16px;
      background: var(--card);
      border: 1px solid var(--border);
    }

    .cert-card h3 {
      font-size: 18px;
      margin-bottom: 8px;
    }

    .cert-card p {
      color: var(--muted);
      font-size: 14px;
    }

    /* CONTACT */

    .contact-box {
      max-width: 850px;
      margin: auto;
      padding: 55px 30px;
      text-align: center;
      border-radius: 25px;
      background: var(--card);
      border: 1px solid var(--border);
    }

    .contact-box h2 {
      font-size: clamp(30px,5vw,46px);
      margin-bottom: 14px;
    }

    .contact-box > p {
      color: var(--muted);
      margin-bottom: 25px;
    }

    .contact-buttons {
      justify-content: center;
    }

    .social-links {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 25px;
    }

    .social-btn {
      padding: 10px 16px;
      border-radius: 9px;
      border: 1px solid var(--border);
      background: rgba(255,255,255,0.04);
      color: #cbd5e1;
      font-size: 13px;
      font-weight: 600;
      transition: 0.3s;
    }

    .social-btn:hover {
      border-color: var(--teal);
      color: var(--teal-light);
    }

    .contact-info {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 18px;
      margin-top: 25px;
      color: #cbd5e1;
      font-size: 13px;
    }

    /* FOOTER */

    footer {
      border-top: 1px solid var(--border);
      padding: 30px 0;
      text-align: center;
      color: var(--muted);
      font-size: 13px;
    }

    /* RESPONSIVE */

    @media (max-width: 900px) {

      .hero-grid {
        grid-template-columns: 1fr;
      }

      .diagram {
        min-height: 430px;
        max-width: 500px;
        margin: auto;
      }

      .skills-grid {
        grid-template-columns: repeat(2,1fr);
      }

      .services-grid {
        grid-template-columns: repeat(2,1fr);
      }

      .case-grid {
        grid-template-columns: repeat(2,1fr);
      }

      .cert-grid {
        grid-template-columns: repeat(2,1fr);
      }
    }

    @media (max-width: 650px) {

      .nav-links {
        display: none;
      }

      section {
        padding: 65px 0;
      }

      .hero {
        padding: 60px 0;
      }

      .hero-grid {
        gap: 20px;
      }

      .hero h1 {
        letter-spacing: -2px;
      }

      .diagram {
        min-height: 370px;
        transform: scale(0.88);
        margin-top: -20px;
        margin-bottom: -30px;
      }

      .diagram::before {
        width: 280px;
        height: 280px;
      }

      .diagram::after {
        width: 210px;
        height: 210px;
      }

      .center-node {
        width: 125px;
        height: 125px;
        font-size: 14px;
      }

      .node {
        width: 94px;
        min-height: 62px;
        font-size: 10px;
      }

      .node-1 {
        top: 15px;
      }

      .node-2 {
        top: 80px;
        right: 0;
      }

      .node-3 {
        bottom: 80px;
        right: 0;
      }

      .node-4 {
        bottom: 15px;
      }

      .node-5 {
        bottom: 80px;
        left: 0;
      }

      .node-6 {
        top: 80px;
        left: 0;
      }

      .about-grid,
      .projects {
        grid-template-columns: 1fr;
      }

      .skills-grid,
      .services-grid,
      .case-grid,
      .cert-grid {
        grid-template-columns: 1fr;
      }

      .experience-card {
        grid-template-columns: 1fr;
      }

      .about-card,
      .project-card,
      .experience-card {
        padding: 24px;
      }

      .btn {
        width: 100%;
      }

      .contact-buttons {
        display: flex;
      }

      .contact-buttons .btn {
        width: 100%;
      }
    }
  </style>
</head>

