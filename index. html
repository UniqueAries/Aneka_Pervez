  <style>
    :root {
      --dark: #0f172a;
      --dark-2: #111c33;
      --teal: #14b8a6;
      --teal-light: #5eead4;
      --white: #ffffff;
      --gray: #94a3b8;
      --light: #f1f5f9;
      --card: rgba(255, 255, 255, 0.06);
      --border: rgba(255, 255, 255, 0.12);
      --shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--dark);
      color: var(--white);
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      max-width: 100%;
      display: block;
    }

    .container {
      width: min(1120px, 92%);
      margin: auto;
    }

    /* NAVBAR */

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(15, 23, 42, 0.94);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }

    nav {
      min-height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .logo {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -1px;
    }

    .logo span {
      color: var(--teal);
    }

    .nav-links {
      display: flex;
      gap: 24px;
      list-style: none;
    }

    .nav-links a {
      color: #cbd5e1;
      font-size: 14px;
      transition: 0.3s;
    }

    .nav-links a:hover {
      color: var(--teal-light);
    }

    /* HERO */

    .hero {
      min-height: 92vh;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: "";
      position: absolute;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      background: rgba(20, 184, 166, 0.12);
      top: 80px;
      right: -100px;
      filter: blur(10px);
    }

    .hero-content {
      position: relative;
      max-width: 850px;
      padding: 80px 0;
    }

    .badge {
      display: inline-block;
      padding: 8px 16px;
      border: 1px solid rgba(20, 184, 166, 0.4);
      border-radius: 50px;
      color: var(--teal-light);
      background: rgba(20, 184, 166, 0.08);
      font-size: 13px;
      margin-bottom: 22px;
    }

    .hero h1 {
      font-size: clamp(42px, 7vw, 78px);
      line-height: 1.02;
      letter-spacing: -3px;
      margin-bottom: 20px;
    }

    .hero h1 span {
      color: var(--teal);
    }

    .hero h2 {
      font-size: clamp(20px, 3vw, 30px);
      color: #cbd5e1;
      margin-bottom: 20px;
      font-weight: 500;
    }

    .hero p {
      max-width: 720px;
      color: var(--gray);
      font-size: 17px;
      margin-bottom: 32px;
    }

    .buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 13px 22px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 14px;
      transition: 0.3s;
      border: 1px solid transparent;
    }

    .btn-primary {
      background: var(--teal);
      color: var(--dark);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      background: var(--teal-light);
    }

    .btn-outline {
      border-color: var(--border);
      color: white;
      background: rgba(255, 255, 255, 0.03);
    }

    .btn-outline:hover {
      border-color: var(--teal);
      color: var(--teal-light);
    }

    /* GENERAL */

    section {
      padding: 90px 0;
    }

    .section-heading {
      margin-bottom: 45px;
    }

    .section-heading small {
      color: var(--teal);
      text-transform: uppercase;
      font-weight: 800;
      letter-spacing: 2px;
      font-size: 12px;
    }

    .section-heading h2 {
      font-size: clamp(30px, 5vw, 46px);
      line-height: 1.1;
      margin-top: 8px;
    }

    .section-heading p {
      color: var(--gray);
      max-width: 680px;
      margin-top: 14px;
    }

    /* ABOUT */

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 35px;
      align-items: stretch;
    }

    .about-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 32px;
      box-shadow: var(--shadow);
    }

    .about-card p {
      color: #cbd5e1;
      margin-bottom: 16px;
    }

    .highlight {
      color: var(--teal-light);
      font-weight: 700;
    }

    /* EXPERIENCE */

    .experience-card {
      display: grid;
      grid-template-columns: 180px 1fr;
      gap: 30px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 32px;
    }

    .experience-number {
      font-size: 42px;
      font-weight: 800;
      color: var(--teal);
      line-height: 1;
    }

    .experience-card h3 {
      margin-bottom: 8px;
      font-size: 23px;
    }

    .experience-card p {
      color: var(--gray);
    }

    /* SKILLS */

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .skill-card {
      padding: 25px;
      border-radius: 16px;
      background: var(--card);
      border: 1px solid var(--border);
      transition: 0.3s;
    }

    .skill-card:hover {
      transform: translateY(-5px);
      border-color: rgba(20, 184, 166, 0.5);
    }

    .skill-card h3 {
      margin-bottom: 12px;
      color: var(--teal-light);
      font-size: 18px;
    }

    .skill-card p {
      color: var(--gray);
      font-size: 14px;
    }

    /* PROJECTS */

    .projects {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 25px;
    }

    .project-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 30px;
      position: relative;
      overflow: hidden;
    }

    .project-card.featured {
      border-color: rgba(20, 184, 166, 0.45);
    }

    .project-label {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 30px;
      background: rgba(20, 184, 166, 0.1);
      color: var(--teal-light);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 15px;
    }

    .project-card h3 {
      font-size: 28px;
      margin-bottom: 10px;
    }

    .project-card h4 {
      color: #cbd5e1;
      font-weight: 500;
      margin-bottom: 15px;
    }

    .project-card p {
      color: var(--gray);
      margin-bottom: 18px;
    }

    .project-list {
      list-style: none;
      margin-bottom: 22px;
    }

    .project-list li {
      color: #cbd5e1;
      font-size: 14px;
      margin: 7px 0;
    }

    .project-list li::before {
      content: "✓";
      color: var(--teal);
      font-weight: bold;
      margin-right: 9px;
    }

    /* CASE STUDY */

    .case-study {
      background: #111c33;
    }

    .case-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }

    .case-box {
      border: 1px solid var(--border);
      padding: 25px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.035);
    }

    .case-box span {
      display: block;
      color: var(--teal);
      font-weight: 800;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 9px;
    }

    .case-box p {
      color: #cbd5e1;
      font-size: 14px;
    }

    /* TOOLS */

    .tools {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .tool {
      padding: 11px 16px;
      border-radius: 9px;
      background: var(--card);
      border: 1px solid var(--border);
      color: #dbeafe;
      font-size: 14px;
    }

    /* CERTIFICATES */

    .cert-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .cert-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 25px;
    }

    .cert-card h3 {
      margin-bottom: 8px;
      font-size: 18px;
    }

    .cert-card p {
      color: var(--gray);
      font-size: 14px;
    }

    /* SERVICES */

    .services-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
    }

    .service {
      padding: 23px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 15px;
    }

    .service h3 {
      font-size: 16px;
      margin-bottom: 7px;
    }

    .service p {
      color: var(--gray);
      font-size: 13px;
    }

    /* CONTACT */

    .contact-box {
      text-align: center;
      max-width: 800px;
      margin: auto;
      padding: 55px 30px;
      border-radius: 25px;
      background: var(--card);
      border: 1px solid var(--border);
    }

    .contact-box h2 {
      font-size: clamp(30px, 5vw, 46px);
      margin-bottom: 15px;
    }

    .contact-box p {
      color: var(--gray);
      margin-bottom: 25px;
    }

    .contact-info {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 25px;
      color: #cbd5e1;
      font-size: 14px;
    }

    /* FOOTER */

    footer {
      border-top: 1px solid var(--border);
      padding: 30px 0;
      color: var(--gray);
      font-size: 13px;
      text-align: center;
    }

    /* MOBILE */

    @media (max-width: 850px) {
      .nav-links {
        display: none;
      }

      .about-grid,
      .projects {
        grid-template-columns: 1fr;
      }

      .skills-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .cert-grid {
        grid-template-columns: 1fr 1fr;
      }

      .services-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .case-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 600px) {
      section {
        padding: 65px 0;
      }

      .hero h1 {
        letter-spacing: -2px;
      }

      .skills-grid,
      .cert-grid,
      .services-grid,
      .case-grid {
        grid-template-columns: 1fr;
      }

      .experience-card {
        grid-template-columns: 1fr;
      }

      .about-card,
      .project-card,
      .experience-card {
        padding: 24px;
      }

      .btn {
        width: 100%;
      }
    }
  </style>
</head>

